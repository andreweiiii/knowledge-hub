# Which AI service answers questions:
#   ollama      free, runs on your own computer (default models below)
#   openai      OpenAI API, needs a funded API key
#   compatible  any other OpenAI-compatible service: set AI_BASE_URL too
#   none        no AI: keyword search returns the best matching passages
AI_PROVIDER=ollama

# Ollama (local)
OLLAMA_CHAT_MODEL=qwen2.5:7b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1

# OpenAI or another compatible service
# AI_API_KEY=
# AI_BASE_URL=https://api.openai.com/v1
# AI_CHAT_MODEL=gpt-4o-mini
# AI_EMBEDDING_MODEL=text-embedding-3-small

# Public demo protections (rate limits, smaller uploads, private history per visitor)
DEMO_MODE=false
